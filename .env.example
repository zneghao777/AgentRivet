# ===== 服务 =====
APP_NAME=agent-harness
APP_ENV=dev
DEBUG=false

# ===== 安全 =====
# 逗号分隔的合法 API Key
API_KEYS=sk-dev-key-1,sk-dev-key-2
DEFAULT_TENANT=default

# ===== 模型（OpenAI 兼容）=====
LLM_MODEL=deepseek-chat
LLM_BASE_URL=https://api.deepseek.com
LLM_API_KEY=
LLM_TEMPERATURE=0.7
LLM_MAX_TOKENS=4096

# ===== 并发防护（开发环境默认值）=====
GUARD_ENABLED=true
LLM_MAX_CONCURRENCY=200
LLM_BG_MAX_CONCURRENCY=8
STREAM_MAX_CONCURRENCY=240
LLM_SLOT_WAIT_TIMEOUT_SECONDS=90
QUEUE_ENABLED=true
QUEUE_CAPACITY=50
QUEUE_TIMEOUT_SECONDS=30
QUEUE_POSITION_PUSH_INTERVAL_S=5
GUARD_OUTCOME_DEADLINE_SECONDS=60
USER_STREAM_LOCK_ENABLED=true
USER_STREAM_LOCK_TTL_S=180

# 异步并发会话（M1/M2；M3 同时启用 MQ_ENABLED）
CHAT_RUN_ENABLED=true
CHAT_RUN_DURABLE_ENABLED=false
CHAT_RUN_MAX_ACTIVE_PER_USER=3
CHAT_RUN_MAX_QUEUED_PER_USER=10
CHAT_RUN_MAX_QUEUED_GLOBAL=10000
CHAT_RUN_MAX_ACTIVE_PER_TENANT=100
CHAT_RUN_TIMEOUT_SECONDS=900
CHAT_RUN_QUEUE_TIMEOUT_SECONDS=0
CHAT_RUN_MAX_ATTEMPTS=3
CHAT_RUN_WORKER_LEASE_SECONDS=60
CHAT_RUN_WORKER_HEARTBEAT_SECONDS=20
CHAT_RUN_APPROVAL_TIMEOUT_SECONDS=86400
CHAT_RUN_EVENT_RETENTION_DAYS=7
CHAT_RUN_EVENT_BATCH_MS=50
CHAT_RUN_EVENT_BATCH_CHARS=512
CHAT_RUN_EVENT_POLL_INTERVAL_MS=1000
CHAT_RUN_REDIS_NOTIFY_ENABLED=true
RATE_LIMIT_ENABLED=true
RATE_LIMIT_STREAM_PER_KEY=10/minute
RATE_LIMIT_REST_PER_KEY=60/minute
RATE_LIMIT_PER_IP=120/minute
RATE_LIMIT_TRUSTED_PROXY_HOPS=0
CB_ENABLED=true
CB_WINDOW_SECONDS=60
CB_MIN_SAMPLES=10
CB_ERROR_RATE_THRESHOLD=0.5
CB_COOLDOWN_SECONDS=30
CB_429_ADAPTIVE_ENABLED=true
LLM_FALLBACK_MODELS=
LLM_CALL_TIMEOUT_SECONDS=120
DEGRADE_ENABLED=true
DEGRADE_HIGH_WATERMARK=0.8
DEGRADE_LOW_WATERMARK=0.7
DEGRADE_ENTER_HOLD_S=60
DEGRADE_EXIT_HOLD_S=120
SEMANTIC_CACHE_ENABLED=false
SEMANTIC_CACHE_SIMILARITY_THRESHOLD=0.95
SEMANTIC_CACHE_TTL_SECONDS=86400
SEMANTIC_CACHE_MAX_ENTRIES=1000
SEMANTIC_CACHE_OPERATION_TIMEOUT_SECONDS=5
SEMANTIC_CACHE_STORE_CONCURRENCY=4
SEMANTIC_CACHE_MAX_PENDING_STORES=100
SEMANTIC_CACHE_SCHEMA_VERSION=v1

# ===== 数据库 =====
# 容器内使用 host: postgres；本地使用 localhost
DATABASE_URL=postgresql+psycopg://harness:harness@postgres:5432/harness

# ===== Redis（可选）=====
REDIS_URL=

# ===== LangGraph =====
CHECKPOINT_SAVE_MODE=async
GRAPH_RECURSION_LIMIT=25
AGENT_TIMEOUT_SECONDS=120.0

# ===== LangSmith =====
LANGSMITH_TRACING=true
LANGSMITH_PROJECT=agent-harness-dev
LANGSMITH_ENDPOINT=
LANGSMITH_API_KEY=

# ===== 会话 =====
SESSION_MAX_HISTORY_MESSAGES=100
SESSION_MAX_TOKEN_BUDGET=500000
MAX_INTERRUPT_PENDING=10

# ===== 多 Agent =====
MULTI_AGENT_ENABLED=false

# ===== RAG / 向量检索 =====
EMBEDDING_MODEL=text-embedding-3-small
# 缺省复用 LLM_BASE_URL / LLM_API_KEY
EMBEDDING_BASE_URL=
EMBEDDING_API_KEY=
EMBEDDING_DIM=1536
RAG_TOP_K=5
RAG_SCORE_THRESHOLD=0.0
RAG_CHUNK_SIZE=500
RAG_CHUNK_OVERLAP=50
RAG_MAX_FILE_SIZE_MB=20
RAG_ALLOWED_EXTS=.md,.txt,.pdf,.docx
