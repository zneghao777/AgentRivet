# ===== 服务 =====
APP_NAME=agent-harness
APP_ENV=dev
DEBUG=false

# ===== 安全 =====
API_KEYS=sk-dev-key-1,sk-dev-key-2
DEFAULT_TENANT=default

# ===== 模型（OpenAI 兼容）=====
LLM_MODEL=deepseek-chat
LLM_BASE_URL=https://api.deepseek.com
LLM_API_KEY=
LLM_TEMPERATURE=0.7
LLM_MAX_TOKENS=4096

# ===== 并发防护（CONCURRENCY_GUARD_SPEC，开发环境默认值）=====
GUARD_ENABLED=true
LLM_MAX_CONCURRENCY=200
LLM_BG_MAX_CONCURRENCY=8
STREAM_MAX_CONCURRENCY=240
LLM_SLOT_WAIT_TIMEOUT_SECONDS=90
QUEUE_ENABLED=true
QUEUE_CAPACITY=50
QUEUE_TIMEOUT_SECONDS=30
QUEUE_POSITION_PUSH_INTERVAL_S=5
GUARD_OUTCOME_DEADLINE_SECONDS=60
USER_STREAM_LOCK_ENABLED=true
USER_STREAM_LOCK_TTL_S=180

# 异步并发会话（M1/M2；M3 同时启用 MQ_ENABLED）
CHAT_RUN_ENABLED=true
CHAT_RUN_DURABLE_ENABLED=false
CHAT_RUN_MAX_ACTIVE_PER_USER=3
CHAT_RUN_MAX_QUEUED_PER_USER=10
CHAT_RUN_MAX_QUEUED_GLOBAL=10000
CHAT_RUN_MAX_ACTIVE_PER_TENANT=100
CHAT_RUN_TIMEOUT_SECONDS=900
CHAT_RUN_QUEUE_TIMEOUT_SECONDS=0
CHAT_RUN_MAX_ATTEMPTS=3
CHAT_RUN_WORKER_LEASE_SECONDS=60
CHAT_RUN_WORKER_HEARTBEAT_SECONDS=20
CHAT_RUN_APPROVAL_TIMEOUT_SECONDS=86400
CHAT_RUN_EVENT_RETENTION_DAYS=7
CHAT_RUN_EVENT_BATCH_MS=50
CHAT_RUN_EVENT_BATCH_CHARS=512
CHAT_RUN_EVENT_POLL_INTERVAL_MS=1000
CHAT_RUN_REDIS_NOTIFY_ENABLED=true
RATE_LIMIT_ENABLED=true
RATE_LIMIT_STREAM_PER_KEY=10/minute
RATE_LIMIT_REST_PER_KEY=60/minute
RATE_LIMIT_PER_IP=120/minute
RATE_LIMIT_TRUSTED_PROXY_HOPS=0
CB_ENABLED=true
CB_WINDOW_SECONDS=60
CB_MIN_SAMPLES=10
CB_ERROR_RATE_THRESHOLD=0.5
CB_COOLDOWN_SECONDS=30
CB_429_ADAPTIVE_ENABLED=true
LLM_FALLBACK_MODELS=
LLM_CALL_TIMEOUT_SECONDS=120
DEGRADE_ENABLED=true
DEGRADE_HIGH_WATERMARK=0.8
DEGRADE_LOW_WATERMARK=0.7
DEGRADE_ENTER_HOLD_S=60
DEGRADE_EXIT_HOLD_S=120
SEMANTIC_CACHE_ENABLED=false
SEMANTIC_CACHE_SIMILARITY_THRESHOLD=0.95
SEMANTIC_CACHE_TTL_SECONDS=86400
SEMANTIC_CACHE_MAX_ENTRIES=1000
SEMANTIC_CACHE_OPERATION_TIMEOUT_SECONDS=5
SEMANTIC_CACHE_STORE_CONCURRENCY=4
SEMANTIC_CACHE_MAX_PENDING_STORES=100
SEMANTIC_CACHE_SCHEMA_VERSION=v1

# ===== 数据库（本地开发用 localhost）=====
DATABASE_URL=postgresql+psycopg://harness:harness@localhost:5432/harness

# ===== Redis（可选）=====
REDIS_URL=

# ===== 消息队列（RabbitMQ；默认关闭）=====
MQ_ENABLED=false
RABBITMQ_URL=amqp://harness:harness@localhost:5672/
MQ_CONFIRM_TIMEOUT_S=2.0
MQ_PREFETCH=200
MQ_OBS_ENABLED=true
MQ_SESSION_ENABLED=true
MQ_SESSION_MAX_RETRIES=3
MQ_RETRY_TTLS_MS=5000,30000,120000
MQ_DEDUPE_TTL_S=86400
MQ_DEADLETTER_ALERT_ENABLED=true
RABBITMQ_MANAGEMENT_URL=http://localhost:15672
MQ_MONITOR_INTERVAL_S=60

# ===== LangGraph =====
CHECKPOINT_SAVE_MODE=async
GRAPH_RECURSION_LIMIT=25
AGENT_TIMEOUT_SECONDS=120.0

# ===== LangSmith（已废弃：可观测体系切换到本地 OpenLLMetry，见 OBSERVABILITY_SPEC）=====
LANGSMITH_TRACING=false
LANGSMITH_PROJECT=agent-harness-dev
LANGSMITH_ENDPOINT=
LANGSMITH_API_KEY=

# ===== 可观测性（OBSERVABILITY_SPEC v2）=====
OBSERVABILITY_ENABLED=true     # 总开关：tracing / 本地落库 / 聚合
TRACE_SAMPLE_RATE=1.0          # 采样率（高并发可调 0.1）
TRACE_RETENTION_DAYS=30        # span/trace 保留天数（后台清理）
LOG_RETENTION_DAYS=14          # 结构化日志保留天数
HOURLY_RETENTION_DAYS=90       # 小时聚合保留天数
DAILY_RETENTION_DAYS=365       # 日聚合保留天数
AUDIT_RETENTION_DAYS=365       # 审计日志保留天数
METRICS_AGG_CRON=0 5 0 * * *   # 每日聚合 cron（当前为简单轮询实现）
CONTENT_CAPTURE_MODE=metadata_only  # metadata_only / redacted / full（§6.3）
REDACTION_VERSION=1            # 脱敏管线版本
OBS_QUEUE_CAPACITY=10000       # 采集队列容量（§5.5）
OBS_WRITE_BATCH_MAX=100        # 每批最大条数
OBS_WRITE_BATCH_MS=200         # 每批最大等待毫秒
OBS_LOG_MIN_LEVEL=WARNING      # 结构化日志转发最低级别（§8.1）
# 默认 SLO（§10.2）
SLO_ERROR_RATE_BUDGET=0.05     # 15min 错误率阈值
SLO_P95_LATENCY_MS=15000       # 15min P95 延迟阈值
SLO_P95_TTFT_MS=3000           # 15min P95 TTFT 阈值
SLO_COST_BUDGET=0.0            # 1h 成本预算（0=禁用）
SLO_TOOL_ERROR_RATE=0.10       # 工具错误率阈值
SLO_TOOL_MIN_CALLS=20          # 工具错误率最小样本
SLO_QUEUE_USAGE=0.80           # 采集队列使用率阈值

# ===== 会话 =====
SESSION_MAX_HISTORY_MESSAGES=100
SESSION_MAX_TOKEN_BUDGET=500000
MAX_INTERRUPT_PENDING=10

# ===== 多 Agent =====
MULTI_AGENT_ENABLED=false
ROUTER_CONFIDENCE_THRESHOLD=0.5
SUPERVISOR_MODEL=
MAX_PARALLEL_WORKERS=5
PLAN_MAX_TASKS=5
WORKER_TIMEOUT_SECONDS=120.0
WORKER_RETRY=1
VERIFIER_LLM_ENABLED=false
AGENT_CIRCUIT_BREAKER_THRESHOLD=3
AGENT_CIRCUIT_BREAKER_COOLDOWN=600
PLAN_CONFIRM_ENABLED=false
AGENT_HUB_ENABLED=true
AGENT_MAX_PER_TENANT=50
AGENT_SYSTEM_PROMPT_MAX_CHARS=20000

# Skill + MCP 统一能力中心
CAPABILITY_HUB_ENABLED=true
CAPABILITY_MAX_TOOLS_PER_RUN=32
MCP_ENABLED=false
MCP_REMOTE_HTTP_ENABLED=true
MCP_STDIO_ENABLED=false
MCP_AUTO_HEALTHCHECK_ENABLED=true
MCP_HEALTHCHECK_INTERVAL_SECONDS=60
MCP_CONNECT_TIMEOUT_SECONDS=10
MCP_DISCOVERY_TIMEOUT_SECONDS=20
MCP_TOOL_TIMEOUT_SECONDS=60
MCP_MAX_OUTPUT_BYTES=1048576
# 生产环境必须配置 Fernet key：python -c 'from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())'
MCP_SECRET_KEY=
# 逗号分隔；留空表示使用平台默认出站策略
MCP_ALLOWED_HOSTS=

# ===== RAG / 向量检索（BGE-M3 本地，OpenAI 兼容，1024 维）=====
EMBEDDING_MODEL=text-embedding-bge-m3
EMBEDDING_BASE_URL=http://192.168.31.185:1234/v1
EMBEDDING_API_KEY=local-bge-m3
EMBEDDING_DIM=1024
RAG_TOP_K=5
RAG_SCORE_THRESHOLD=0.0
RAG_CHUNK_SIZE=500
RAG_CHUNK_OVERLAP=50
RAG_MAX_FILE_SIZE_MB=50
RAG_ALLOWED_EXTS=.md,.txt,.pdf,.docx

# ===== 混合检索 / Rerank / Query 改写（AGENTIC_RAG_UPGRADE_SPEC §3.1）=====
HYBRID_RETRIEVAL_ENABLED=true        # 混合检索总开关：false 时退回纯向量（兼容旧行为）
KEYWORD_BACKEND=pg_trgm              # pg_trgm | tsvector（本期仅 pg_trgm，tsvector 预留）
KEYWORD_TOP_K=20                     # 关键词路召回数
VECTOR_TOP_K=20                      # 向量路召回数（混合时粗排候选数）
KEYWORD_SCORE_THRESHOLD=0.08         # pg_trgm similarity 阈值
RRF_K=60                             # RRF 融合常数（标准 60）
RERANK_ENABLED=true                  # Rerank 总开关（服务不可达自动跳过，不阻塞检索）
RERANK_BASE_URL=http://192.168.31.185:1234/v1   # OpenAI 兼容 /rerank 服务
RERANK_MODEL=bge-reranker-v2-m3
RERANK_TOP_N=5                       # 精排后返回条数
RERANK_HTTP_TIMEOUT_SECONDS=30
RERANK_USE_FLAG_EMBEDDING=false      # 进程内 FlagEmbedding fallback（可选依赖）
QUERY_EXPAND_ENABLED=false           # Query 改写开关（默认关：每次检索多一次 LLM 调用）
# 可选改写提示词模板，留空则用内置模板
QUERY_EXPAND_TEMPLATE=

# ===== GLM 文件解析（异步；multipart 直传文件，图片自动走 OCR；留空则回退本地解析）=====
GLM_FILES_API_KEY=
GLM_FILES_BASE_URL=https://open.bigmodel.cn/api/paas/v4
GLM_FILES_MODEL=glm-files-parser
# lite / expert / prime；expert 仅支持 pdf，图片 OCR 需 prime 或 lite
GLM_FILES_TOOL=prime
GLM_FILES_POLL_SECONDS=3
GLM_FILES_TIMEOUT_SECONDS=180

# ===== 上传 / 解析 =====
KB_UPLOAD_DIR=data/uploads
# multipart 直传无需公网 URL，此配置仅作预留
KB_PUBLIC_BASE_URL=

# ===== 长期记忆（MEMORY_SPEC §6/§7）=====
MEMORY_ENABLED=true
MEMORY_AUTO_INJECT=true
MEMORY_SEARCH_TOOL=true
MEMORY_TOP_K=5
MEMORY_SIM_DUP=0.92
MEMORY_SIM_CONFLICT=0.70
MEMORY_CONFIDENCE_PENDING=0.6
MEMORY_DEFAULT_TTL_DAYS=90
MEMORY_EXTRACT_MAX_ITEMS=10
MEMORY_STRENGTHEN_THRESHOLD=3
# 未登录阶段的统一占位用户 ID（替换旧硬编码 "api-user"）
ANONYMOUS_USER_ID=__anonymous__

# ===== Graph RAG 知识图谱（GRAPH_RAG_SPEC §7）=====
GRAPH_ENABLED=true                      # 图谱总开关（false 时不注册图检索工具/不触发构建）
GRAPH_EXTRACT_MODEL=glm-4-flash         # 实体/关系抽取模型（低成本模型）
GRAPH_EXTRACT_BASE_URL=https://open.bigmodel.cn/api/paas/v4  # 智谱 GLM chat
GRAPH_EXTRACT_API_KEY=                  # 智谱 key；留空回退 LLM_BASE_URL/LLM_API_KEY
GRAPH_BATCH_SIZE=8                      # 每批合并 chunk 数（成本控制）
GRAPH_MAX_ENTITIES_PER_CHUNK=30         # 单 chunk 实体上限
GRAPH_ENTITY_VECTOR_MODEL=text-embedding-bge-m3  # 复用现有向量模型
GRAPH_ALIAS_SIMILARITY_THRESHOLD=0.90   # 实体合并向量阈值
GRAPH_MAX_HOP=3                         # 图扩散最大跳数
GRAPH_COMMUNITY_ENABLED=true            # 社区摘要开关
GRAPH_CONCURRENCY=4                     # 异步抽取并发
GRAPH_BUILD_MAX_CHUNKS=400              # 单次构建最多处理 chunk（长文档保护）
GRAPH_MIN_SIMILARITY=0.35               # 实体语义召回最低相似度

# ===== KBX 知识库索引模式与统一检索 =====
KB_INDEX_MODE_ENABLED=true
KB_INDEX_JOBS_ENABLED=true
KB_UNIFIED_RETRIEVAL_ENABLED=true
KB_GRAPH_WORKSPACE_ENABLED=true
KB_INDEX_JOB_STALE_SECONDS=300
