# ============================================================
# 生产部署环境变量模板
# 用法: cp .env.prod.example .env.prod 然后按需修改
# ⚠️ 此文件含真实密钥,已被 .gitignore 忽略,切勿提交到仓库!
# 默认值与开发环境 backend/.env 保持一致
# ============================================================

# ---- 镜像来源(GitHub Container Registry)(必须改) ----
# 对应 CI 推送地址 ghcr.io/<owner>/<repo>/backend:latest
GHCR_OWNER=zneghao777
GHCR_REPO=myagentdemo1

# ---- PostgreSQL(与开发环境一致:harness / harness) ----
POSTGRES_PASSWORD=harness

# ---- 服务 ----
APP_ENV=prod
CONTENT_CAPTURE_MODE=redacted

# ---- 模型(OpenAI 兼容；生产指向甲方本地 vLLM) ----
# vLLM 服务端必须同时配置 --max-num-seqs 100，形成双层硬保护。
LLM_MODEL=Qwen3.8-27B-W8A8
LLM_BASE_URL=http://vllm-host:8000/v1
LLM_API_KEY=local-vllm-key
LLM_TEMPERATURE=0.7
LLM_MAX_TOKENS=4096

# ---- 并发防护(本地模型 100 路上限的生产默认值) ----
GUARD_ENABLED=true
LLM_MAX_CONCURRENCY=90
LLM_BG_MAX_CONCURRENCY=8
STREAM_MAX_CONCURRENCY=120
LLM_SLOT_WAIT_TIMEOUT_SECONDS=90
QUEUE_ENABLED=true
QUEUE_CAPACITY=100
QUEUE_TIMEOUT_SECONDS=60
QUEUE_POSITION_PUSH_INTERVAL_S=5
GUARD_OUTCOME_DEADLINE_SECONDS=60
USER_STREAM_LOCK_ENABLED=true
USER_STREAM_LOCK_TTL_S=180

# 异步并发会话；生产启用 Durable run 和 RabbitMQ Outbox
CHAT_RUN_ENABLED=true
CHAT_RUN_DURABLE_ENABLED=true
CHAT_RUN_MAX_ACTIVE_PER_USER=3
CHAT_RUN_MAX_QUEUED_PER_USER=10
CHAT_RUN_MAX_QUEUED_GLOBAL=10000
CHAT_RUN_MAX_ACTIVE_PER_TENANT=100
CHAT_RUN_TIMEOUT_SECONDS=900
CHAT_RUN_QUEUE_TIMEOUT_SECONDS=0
CHAT_RUN_MAX_ATTEMPTS=3
CHAT_RUN_WORKER_LEASE_SECONDS=60
CHAT_RUN_WORKER_HEARTBEAT_SECONDS=20
CHAT_RUN_APPROVAL_TIMEOUT_SECONDS=86400
CHAT_RUN_EVENT_RETENTION_DAYS=7
CHAT_RUN_EVENT_BATCH_MS=50
CHAT_RUN_EVENT_BATCH_CHARS=512
CHAT_RUN_EVENT_POLL_INTERVAL_MS=1000
CHAT_RUN_REDIS_NOTIFY_ENABLED=true
RATE_LIMIT_ENABLED=true
RATE_LIMIT_STREAM_PER_KEY=10/minute
RATE_LIMIT_REST_PER_KEY=60/minute
RATE_LIMIT_PER_IP=120/minute
# 标准 compose 由前端 Nginx 代理一跳；若改为后端直连则必须设回 0。
RATE_LIMIT_TRUSTED_PROXY_HOPS=1
CB_ENABLED=true
CB_WINDOW_SECONDS=60
CB_MIN_SAMPLES=10
CB_ERROR_RATE_THRESHOLD=0.5
CB_COOLDOWN_SECONDS=30
CB_429_ADAPTIVE_ENABLED=true
LLM_FALLBACK_MODELS=
LLM_CALL_TIMEOUT_SECONDS=120
DEGRADE_ENABLED=true
DEGRADE_HIGH_WATERMARK=0.8
DEGRADE_LOW_WATERMARK=0.7
DEGRADE_ENTER_HOLD_S=60
DEGRADE_EXIT_HOLD_S=120
SEMANTIC_CACHE_ENABLED=false
SEMANTIC_CACHE_SIMILARITY_THRESHOLD=0.95
SEMANTIC_CACHE_TTL_SECONDS=86400
SEMANTIC_CACHE_MAX_ENTRIES=1000
SEMANTIC_CACHE_OPERATION_TIMEOUT_SECONDS=5
SEMANTIC_CACHE_STORE_CONCURRENCY=4
SEMANTIC_CACHE_MAX_PENDING_STORES=100
SEMANTIC_CACHE_SCHEMA_VERSION=v1

# ---- Embedding(与开发环境一致;BGE-M3,1024 维) ----
# 注意:容器内访问宿主机上的本地模型服务时,若局域网 IP 不通,
# 可改为 http://host.docker.internal:1234/v1 (Docker Desktop)
EMBEDDING_MODEL=text-embedding-bge-m3
EMBEDDING_BASE_URL=http://192.168.31.185:1234/v1
EMBEDDING_API_KEY=local-bge-m3
EMBEDDING_DIM=1024

# ---- Rerank(与开发环境一致) ----
RERANK_ENABLED=true
RERANK_BASE_URL=http://192.168.31.185:1234/v1
RERANK_MODEL=bge-reranker-v2-m3
RERANK_TOP_N=5

# ---- GLM 文件解析(与开发环境一致,留空则回退本地解析) ----
GLM_FILES_API_KEY=
GLM_FILES_BASE_URL=https://open.bigmodel.cn/api/paas/v4
GLM_FILES_MODEL=glm-files-parser
GLM_FILES_TOOL=prime

# ---- 安全 ----
API_KEYS=sk-dev-key-1,sk-dev-key-2
DEFAULT_TENANT=default
# MCP 凭据加密:开发环境留空使用稳定派生密钥;生产建议填写 Fernet key
MCP_SECRET_KEY=

# ---- 长期记忆 / Graph RAG(与开发环境一致) ----
MEMORY_ENABLED=true
MEMORY_DEFAULT_TTL_DAYS=90
GRAPH_ENABLED=true
GRAPH_EXTRACT_MODEL=glm-4-flash

# ---- RabbitMQ ----
MQ_ENABLED=true
RABBITMQ_PASSWORD=replace-with-a-strong-password
RABBITMQ_URL=amqp://harness:${RABBITMQ_PASSWORD}@rabbitmq:5672/
RABBITMQ_MANAGEMENT_URL=http://rabbitmq:15672
MQ_CONFIRM_TIMEOUT_S=2.0
MQ_PREFETCH=200
MQ_OBS_ENABLED=true
MQ_SESSION_ENABLED=true
MQ_SESSION_MAX_RETRIES=3
MQ_RETRY_TTLS_MS=5000,30000,120000
MQ_DEDUPE_TTL_S=86400
MQ_DEADLETTER_ALERT_ENABLED=true
