# ============================================================
# 生产部署环境变量模板
# 用法: cp .env.prod.example .env.prod 然后按需修改
# ⚠️ 此文件含真实密钥,已被 .gitignore 忽略,切勿提交到仓库!
# 默认值与开发环境 backend/.env 保持一致
# ============================================================

# ---- 镜像来源(GitHub Container Registry)(必须改) ----
# 对应 CI 推送地址 ghcr.io/<owner>/<repo>/backend:latest
GHCR_OWNER=zneghao777
GHCR_REPO=myagentdemo1

# ---- PostgreSQL(与开发环境一致:harness / harness) ----
POSTGRES_PASSWORD=harness

# ---- 服务 ----
APP_ENV=prod
CONTENT_CAPTURE_MODE=redacted

# ---- 模型(OpenAI 兼容,与开发环境一致) ----
LLM_MODEL=deepseek-v4-flash
LLM_BASE_URL=https://api.deepseek.com
LLM_API_KEY=your-llm-api-key
LLM_TEMPERATURE=0.7
LLM_MAX_TOKENS=4096

# ---- Embedding(与开发环境一致;BGE-M3,1024 维) ----
# 注意:容器内访问宿主机上的本地模型服务时,若局域网 IP 不通,
# 可改为 http://host.docker.internal:1234/v1 (Docker Desktop)
EMBEDDING_MODEL=text-embedding-bge-m3
EMBEDDING_BASE_URL=http://192.168.31.185:1234/v1
EMBEDDING_API_KEY=local-bge-m3
EMBEDDING_DIM=1024

# ---- Rerank(与开发环境一致) ----
RERANK_ENABLED=true
RERANK_BASE_URL=http://192.168.31.185:1234/v1
RERANK_MODEL=bge-reranker-v2-m3
RERANK_TOP_N=5

# ---- GLM 文件解析(与开发环境一致,留空则回退本地解析) ----
GLM_FILES_API_KEY=
GLM_FILES_BASE_URL=https://open.bigmodel.cn/api/paas/v4
GLM_FILES_MODEL=glm-files-parser
GLM_FILES_TOOL=prime

# ---- 安全 ----
API_KEYS=sk-dev-key-1,sk-dev-key-2
DEFAULT_TENANT=default
# MCP 凭据加密:开发环境留空使用稳定派生密钥;生产建议填写 Fernet key
MCP_SECRET_KEY=

# ---- 长期记忆 / Graph RAG(与开发环境一致) ----
MEMORY_ENABLED=true
MEMORY_DEFAULT_TTL_DAYS=90
GRAPH_ENABLED=true
GRAPH_EXTRACT_MODEL=glm-4-flash

# ---- RabbitMQ ----
MQ_ENABLED=true
RABBITMQ_PASSWORD=replace-with-a-strong-password
RABBITMQ_URL=amqp://harness:${RABBITMQ_PASSWORD}@rabbitmq:5672/
RABBITMQ_MANAGEMENT_URL=http://rabbitmq:15672
MQ_CONFIRM_TIMEOUT_S=2.0
MQ_PREFETCH=200
MQ_OBS_ENABLED=true
MQ_SESSION_ENABLED=true
MQ_SESSION_MAX_RETRIES=3
MQ_RETRY_TTLS_MS=5000,30000,120000
MQ_DEDUPE_TTL_S=86400
MQ_DEADLETTER_ALERT_ENABLED=true
